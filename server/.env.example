NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/geo_shalmani
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

JWT_COOKIE_DAYS=7

SEED_ADMIN_NAME=Shalmani Sb
SEED_ADMIN_EMAIL=your-email-admin
SEED_ADMIN_PASSWORD=your-password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backups
BACKUP_AUTO=true
BACKUP_CRON=0 2 * * *
BACKUP_TZ=Asia/Karachi
BACKUP_KEEP=14
# BACKUP_DIR=./backups

ALERT_CRON=0 8 * * *
ALERT_TZ=Asia/Karachi

# Production only (see the deployment guide)
# COOKIE_SAMESITE=lax
# TRUST_PROXY=true
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/geo_shalmani
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

JWT_COOKIE_DAYS=7

SEED_ADMIN_NAME=Shalmani Sb
SEED_ADMIN_EMAIL=your-email-admin
SEED_ADMIN_PASSWORD=your-password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backups
BACKUP_AUTO=true
BACKUP_CRON=0 2 * * *
BACKUP_TZ=Asia/Karachi
BACKUP_KEEP=14
# BACKUP_DIR=./backups

ALERT_CRON=0 8 * * *
ALERT_TZ=Asia/Karachi

# Production only (see the deployment guide)
# COOKIE_SAMESITE=lax
# TRUST_PROXY=true

# --- Automation ---
TZ=Asia/Karachi
SUMMARY_ENABLED=true
SUMMARY_CRON=0 20 * * *
SUMMARY_CHANNELS=whatsapp,email

# --- WhatsApp Cloud API ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=paste_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=paste_phone_number_id
WHATSAPP_WABA_ID=paste_waba_id
WHATSAPP_VERIFY_TOKEN=any_random_long_string
WHATSAPP_APP_SECRET=paste_app_secret
WHATSAPP_SUMMARY_TEMPLATE=daily_summary
OWNER_WHATSAPP=923001234567   # country code, no + and no spaces

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=gmail_app_password
OWNER_EMAIL=owner@example.com